<launch>
  <!-- 도메인 브릿지 (관제 PC 100): pinky1(10<->100), pinky2(20<->100), pinky3(30<->100)
       한 대만 띄우려면 pinky2:=false 처럼 지정 -->
  <arg name="pinky1" default="true" description="pinky1 브릿지 실행 여부"/>
  <arg name="pinky2" default="true" description="pinky2 브릿지 실행 여부"/>
  <arg name="pinky3" default="true" description="pinky3 브릿지 실행 여부"/>

  <executable cmd="ros2 run domain_bridge domain_bridge $(find-pkg-share domain_bridge)/config/pinky_bridge_pinky1.yaml"
              name="domain_bridge_pinky1" output="screen" if="$(var pinky1)"/>
  <executable cmd="ros2 run domain_bridge domain_bridge $(find-pkg-share domain_bridge)/config/pinky_bridge_pinky2.yaml"
              name="domain_bridge_pinky2" output="screen" if="$(var pinky2)"/>
  <executable cmd="ros2 run domain_bridge domain_bridge $(find-pkg-share domain_bridge)/config/pinky_bridge_pinky3.yaml"
              name="domain_bridge_pinky3" output="screen" if="$(var pinky3)"/>
</launch>
